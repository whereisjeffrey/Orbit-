    "Every attempt builds the muscle memory. Keep speaking." : {
      "comment" : "A message encouraging users to continue practicing after mastering a set of words.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
