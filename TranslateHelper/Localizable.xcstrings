          }
        }
      }
    },
    "We'll show you what's actually relevant\nto where you are right now." : {
      "comment" : "A description under the main heading of the view, explaining that the app will guide the user to relevant content based on their location.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
